FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install -e ".[tracking,onnx]"
COPY configs ./configs

EXPOSE 8000
CMD ["uvicorn", "foodvision.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

